{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "ansury-ai-1.html",
          "ansury-ai (1).html",
          "favicon.svg",
          "apple-touch-icon.svg",
          "site.webmanifest",
          "robots.txt",
          "sitemap.xml",
          "llms.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
